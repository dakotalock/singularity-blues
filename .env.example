# Required later (Dakota): Google AI Studio key
GEMINI_API_KEY=
# Writer/selector/condenser cascade. Do not pin via GEMINI_WRITER_MODEL.
GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.5-flash-lite
GEMMA_MODELS=gemma-4-31b-it,gemma-4-26b-a4b-it
# Bounded concurrency. Defaults are tuned for the small Render service.
PRIVATE_SHOWING_WORKERS=8
PIPER_WORKERS=3
PIPER_MAX_PROCESSES=3
# Optional YouTube RTMP — not needed for local watch
YOUTUBE_RTMP_URL=
YOUTUBE_STREAM_KEY=

# Stripe hosted Checkout. Secret/webhook/publishable stay in the host env — never commit them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_1=price_1U8uTFP7GC34loHe2Es9DQ9J
STRIPE_PRICE_5=price_1U8uTGP7GC34loHeXOgvN3rn
STRIPE_PRICE_10=price_1U8uTGP7GC34loHeCLoowbVf
STRIPE_PRICE_20=price_1U8uTHP7GC34loHeN1Goa4MJ
OWNER_PROMPT_SECRET=
PUBLIC_BASE_URL=https://singularity-blues.onrender.com
DATABASE_URL=
