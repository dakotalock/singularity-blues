# chmod 600 after copying to /etc/singularity-blues-relay.env
BROADCAST_SOURCE_URL=https://singularity-blues.onrender.com/broadcast/live.m3u8
TWITCH_RTMP_URL=rtmps://live.twitch.tv/app
TWITCH_STREAM_KEY=replace-me
# Or set one complete destination instead:
# RTMP_URL=rtmps://live.twitch.tv/app/replace-me

SOURCE_TIMEOUT=25
FALLBACK_SECONDS=30
MAX_BACKOFF=60
MAX_PROGRESS_AGE=45
